{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CABINET_STATUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CABINET_STATUS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"}
  ]
}
